#!/usr/bin/env python3
"""Bounded pause of exactly this study receiver; resume the same argv/UID automatically."""
import os, sys, json, time, signal, subprocess, hashlib, re
from pathlib import Path

root, node, pid_text, duration_text, mode = sys.argv[1:]
if not re.fullmatch(r'/[A-Za-z0-9/._-]+/github/workspaces/codex/yataverse-storage-persistent-20261011', root):
    raise ValueError('dedicated study root required')
if not re.fullmatch(r'/[A-Za-z0-9/._-]+', node) or mode not in ('dry-run', 'pause'):
    raise ValueError('node path/action')
pid, duration = int(pid_text), int(duration_text)
if pid <= 1 or not 1 <= duration <= 300 or os.getuid() == 0:
    raise ValueError('bounded same-user process only')
expected = [node, '--max-old-space-size=1024', root+'/runtime-buffered-02/custody_restore.cljk', root+'/trust-buffered-02.json', root+'/repair-from-xavier-buffered-02', 'raw']
code_sha = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()

def inspect():
    p = subprocess.run(['ps', '-p', str(pid), '-o', 'uid=', '-o', 'state=', '-o', 'args='], capture_output=True, text=True, check=True)
    uid, state, argv = p.stdout.strip().split(None, 2)
    if int(uid) != os.getuid() or argv.split() != expected:
        raise ValueError('receiver ownership/argv mismatch')
    return state, hashlib.sha256(argv.encode()).hexdigest()

def record(action, argv_sha):
    row = {'schema':'yataverse-bounded-receiver-pause/v1','action':action,'pid':pid,'uid':os.getuid(),'argvSHA':argv_sha,'codeSHA':code_sha,'unixSeconds':time.time(),'durationSeconds':duration,'scope':'dedicated receiver only; existing services and network configuration unchanged'}
    encoded = json.dumps(row)+'\n'
    if mode == 'pause':
        fd = os.open(root+'/receiver-pause-events.jsonl', os.O_WRONLY|os.O_CREAT|os.O_APPEND, 0o600)
        try:
            os.write(fd, encoded.encode()); os.fsync(fd)
        finally: os.close(fd)
    print(encoded, end='', flush=True)

state, argv_sha = inspect()
if 'T' in state:
    raise ValueError('already stopped receiver must not be resumed by this helper')
if mode == 'dry-run':
    record('qualified-dry-run', argv_sha)
    sys.exit(0)

def interrupted(signum, frame):
    raise InterruptedError('pause helper interrupted')
signal.signal(signal.SIGTERM, interrupted)
signal.signal(signal.SIGINT, interrupted)
phase = Path(root+'/phase.txt')
previous_phase = phase.read_text()
pause_phase = 'buffered-receiver-paused-probe\n'
record('pause-request', argv_sha)
stopped = False
try:
    stopped = True
    os.kill(pid, signal.SIGSTOP)
    phase.write_text(pause_phase)
    record('paused', argv_sha)
    time.sleep(duration)
finally:
    if stopped:
        _, current_sha = inspect()
        if current_sha != argv_sha:
            raise ValueError('PID identity drift: refusing signal')
        os.kill(pid, signal.SIGCONT)
        if phase.read_text() == pause_phase:
            phase.write_text(previous_phase)
        record('resumed', argv_sha)
